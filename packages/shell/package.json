{
  "name": "@glosa/shell",
  "version": "0.1.0-alpha.34",
  "private": true,
  "description": "glosa desktop shell: an Electron window on the daemon-served SPA",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "postinstall": "bun scripts/brand-electron.ts",
    "brand": "bun scripts/brand-electron.ts",
    "start": "electron .",
    "package": "bun scripts/package-app.ts",
    "smoke": "bun scripts/app-smoke.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "trustedDependencies": [
    "electron"
  ],
  "glosa": {
    "minimumDaemon": "0.1.0-alpha.34",
    "releases": "https://github.com/davebream/glosa/releases"
  },
  "productName": "glosa",
  "build": {
    "appId": "dev.glosa.app",
    "productName": "glosa",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "assets/**"
    ],
    "files": [
      "src/**/*",
      "assets/icon-512.png",
      "assets/icon-dark-512.png",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "artifactName": "glosa-${version}-${arch}.${ext}",
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "binaries": [
        "Contents/Resources/bin/bun"
      ],
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "glosa uses the microphone only when you click Dictate, and only if you configured a dictation provider."
      }
    },
    "dmg": {
      "sign": false
    }
  }
}
