{
  "name": "@davebream/glosa",
  "version": "0.1.0-alpha.38",
  "description": "Local-first writing and review workspace for people working with AI coding agents.",
  "license": "Apache-2.0",
  "author": "Dawid Leszczyński",
  "private": false,
  "type": "module",
  "bin": {
    "glosa": "packages/cli/src/main.ts"
  },
  "files": [
    "packages/cli/src",
    "packages/daemon/src",
    "packages/providers/claude-code/src",
    "packages/providers/codex/src",
    "packages/providers/openai-transcription/src",
    "packages/spa/src",
    ".claude-plugin/marketplace.json",
    "glosa-plugin",
    "README.md",
    "ROADMAP.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "workspaces": [
    "packages/cli",
    "packages/daemon",
    "packages/spa",
    "packages/providers/*"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "engines": {
    "bun": ">=1.2.7"
  },
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davebream/glosa.git"
  },
  "homepage": "https://github.com/davebream/glosa#readme",
  "bugs": {
    "url": "https://github.com/davebream/glosa/issues"
  },
  "keywords": [
    "ai-agents",
    "writing",
    "local-first",
    "claude-code",
    "codex",
    "markdown"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "bun test",
    "test:acceptance": "bun run scripts/test-acceptance.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . --no-errors-on-unmatched",
    "lint:staged": "biome lint --staged --no-errors-on-unmatched",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run lint && bun run typecheck && bun run test:ci && bun run version:check && bun run format:check",
    "setup:hooks": "lefthook install --reset-hooks-path",
    "audit:licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow '0BSD;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;MIT;Python-2.0'",
    "package:check": "bun run scripts/package-smoke.ts",
    "version:check": "bun run scripts/version-sync.ts --check",
    "version:sync": "bun run scripts/version-sync.ts --write",
    "test:ci": "bun run scripts/test-runner.ts ci",
    "test:docs": "bun run scripts/test-runner.ts docs",
    "test:stability": "bun run scripts/test-runner.ts stability",
    "test:full": "bun run scripts/test-runner.ts full",
    "themes:render": "bun run scripts/render-themes.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.4.0",
    "@types/markdown-it": "^14.2.0",
    "@types/picomatch": "^4.0.3",
    "happy-dom": "^20.13.2",
    "lefthook": "^2.1.12",
    "license-checker-rseidelsohn": "5.0.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@gunshi/plugin-completion": "0.37.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chokidar": "^5",
    "diff2html": "^3.4.56",
    "fast-xml-parser": "5.11.1",
    "gunshi": "0.37.3",
    "idiomorph": "^0.8.0",
    "ignore": "7.0.10",
    "image-size": "2.0.4",
    "markdown-it": "^14.3.1",
    "openai": "7.26.0",
    "picomatch": "^4.0.7",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@hono/node-server": "2.0.10",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.8",
    "qs": "6.16.0",
    "hono": "4.13.7",
    "ip-address": "10.7.1",
    "tar": "7.5.22",
    "undici": "6.28.1"
  }
}
